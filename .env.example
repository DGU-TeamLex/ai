NEWS_API_KEY=
EVENT_REGISTRY_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# Required only by the explicit AI batch loader. Keep unset for compute-only runs.
DATABASE_URL=

# News batch input. Use sample for smoke tests, csv for prepared history,
# or gdelt for keyless monthly article collection.
NEWS_PROVIDER=disabled
NEWS_DATA_PATH=data/raw/news/news_history.csv
NEWS_START_DATE=2018-01-01
NEWS_END_DATE=2025-12-31
NEWS_REFRESH=false
GDELT_MAX_RECORDS=250
GDELT_REQUEST_DELAY_SECONDS=5.0

# Commodity/market batch input. Prefer csv for licensed futures or price
# assessments. Alpha Vantage and FRED adapters require their API keys above.
COMMODITY_PROVIDER=disabled
COMMODITY_DATA_PATH=data/external/market/commodity_prices.csv
COMMODITY_START_DATE=2024-01-01
COMMODITY_END_DATE=2025-12-31
COMMODITY_REFRESH=false
COMMODITY_ALLOW_SAMPLE_FALLBACK=false
ALPHA_VANTAGE_REQUEST_DELAY_SECONDS=1.2
NASDAQ_DATA_LINK_API_KEY=
