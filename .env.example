NEWS_API_KEY=
EVENT_REGISTRY_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# Required only by the explicit AI batch loader. Keep unset for compute-only runs.
DATABASE_URL=

# News batch input. Use sample for smoke tests, csv for prepared history,
# or gdelt for keyless monthly article collection.
NEWS_PROVIDER=disabled
NEWS_DATA_PATH=data/raw/news/news_history.csv
NEWS_START_DATE=2018-01-01
NEWS_END_DATE=2025-12-31
NEWS_REFRESH=false
GDELT_MAX_RECORDS=250
GDELT_REQUEST_DELAY_SECONDS=5.0
GDELT_QUERY_MODE=combined
GDELT_MAX_RETRIES=8
GDELT_RATE_LIMIT_BACKOFF_SECONDS=30.0
GDELT_MAX_BACKOFF_SECONDS=300.0
# Realtime fallback while the legacy DOC API is rate-limited.
GDELT_NGRAM_BATCH_COUNT=4
GDELT_NGRAM_LOOKBACK_MINUTES=45
GDELT_NGRAM_LANGUAGES=en,ko
GDELT_NGRAM_APPEND_CACHE=true

# Commodity/market batch input. Prefer csv for licensed futures or price
# assessments. Alpha Vantage and FRED adapters require their API keys above.
COMMODITY_PROVIDER=disabled
COMMODITY_DATA_PATH=data/external/market/commodity_prices.csv
COMMODITY_START_DATE=2024-01-01
COMMODITY_END_DATE=2025-12-31
COMMODITY_REFRESH=false
COMMODITY_ALLOW_SAMPLE_FALLBACK=false
ALPHA_VANTAGE_REQUEST_DELAY_SECONDS=1.2
NASDAQ_DATA_LINK_API_KEY=

# Korea Customs Service monthly import/export input. KCS access requires
# separate data.go.kr usage approval even when DATA_GO_KR_SERVICE_KEY exists.
TRADE_PROVIDER=disabled
TRADE_START_MONTH=2023-01
TRADE_END_MONTH=2026-06
TRADE_REFRESH=false
# Leave blank to use data/mapping/trade_country_scope.csv.
TRADE_COUNTRY_CODES=
TRADE_REQUEST_DELAY_SECONDS=0.2
TRADE_MAX_REQUESTS=1000
TRADE_MAX_RETRIES=5
TRADE_RETRY_BACKOFF_SECONDS=2.0
